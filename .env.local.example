# Real AI provider configuration.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Development-only mock mode. Never enabled in production.
AI_ALLOW_MOCK=false

# Per-project monthly hard budget (USD).
AI_MONTHLY_LIMIT_USD=5

# Required for real-provider calls: configure these from the provider's current pricing
# for the selected model. Values are USD per 1,000,000 input/output tokens.
AI_INPUT_COST_PER_1M_USD=
AI_OUTPUT_COST_PER_1M_USD=
