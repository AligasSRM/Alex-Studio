# Real AI provider configuration.
# Without AI_API_KEY, chat requests return a clear 503 unless mock mode is
# explicitly enabled in development.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Development-only mock mode. Never enabled in production.
AI_ALLOW_MOCK=false

# Monthly spend limits are not enforced yet; do not treat this as a billing guard.
# Implement provider-reported usage persistence and hard-limit enforcement before production use.
